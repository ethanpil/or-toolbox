{
  "id": "model-arena",
  "name": "Model arena",
  "description": "Send one input to several models and compare answers, cost and speed.",
  "category": "reasoning",
  "icon": "trophy",
  "capabilities": ["text", "vision"],
  "accepts": [
    "image/png",
    "image/jpeg",
    "image/webp",
    "image/gif",
    "application/pdf",
