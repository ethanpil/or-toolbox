    "application/json",
    "application/xml",
    "audio/*"
  ],
  "produces": ["text/markdown", "application/json"],
  "usesJobs": false,
  "ownModels": true,
  "lazyLibs": ["marked", "dompurify"],
  "defaults": {}
}
