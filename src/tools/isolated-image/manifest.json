{
  "id": "isolated-image",
  "name": "Isolated image",
  "description": "Put product photos on a pure white square, checked and ready for a shop.",
  "category": "images",
  "icon": "bounding-box",
  "capabilities": ["image"],
  "accepts": ["image/png", "image/jpeg", "image/webp"],
  "produces": ["image/jpeg", "image/png", "application/zip"],
  "usesJobs": false,
  "lazyLibs": ["fflate"],
  "defaults": {
    "size": 2000,
    "margin": 0.08,
    "whiteThreshold": 245,
    "sharpen": true,
    "sharpenAmount": 0.5,
    "shadow": false,
    "format": "jpg",
    "jpegQuality": 92,
    "filenamePattern": "{name}-white.{ext}",
    "sendSize": 1024,
    "concurrency": 2
  }
}
