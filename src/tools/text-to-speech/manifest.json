{
  "id": "text-to-speech",
  "name": "Text-to-speech",
  "description": "Read text aloud in a chosen voice, stitched into one audio file.",
  "category": "audio",
  "icon": "volume-up",
  "capabilities": ["tts"],
  "accepts": ["text/plain", "text/markdown"],
  "produces": ["audio/mpeg", "audio/wav"],
  "usesJobs": false,
  "lazyLibs": ["@ffmpeg/ffmpeg", "marked"],
  "defaults": {
    "format": "mp3"
  }
}
